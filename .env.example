# Settings for compose.prod.yaml. Copy to .env next to it and fill in.

# The public host name of your instance, without scheme or path. Its DNS
# A/AAAA records must point at this machine before the first start, so
# Let's Encrypt can issue the certificate.
TYPSTRY_DOMAIN=typst.example.com

# Where Let's Encrypt sends notices about the certificate.
ACME_EMAIL=admin@example.com

# Optional: try the setup against Let's Encrypt's staging CA first. Its
# certificates are not trusted by browsers, but its limits are generous.
# Remove the line (and the traefik-acme volume) to switch to real ones.
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
