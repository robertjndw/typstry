{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:static": "tsc -b && VITE_TYPSTRY_LOCAL_ONLY=1 vite build --outDir dist-static",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:static": "playwright test -c playwright.static.config.ts",
    "fixtures": "TYPSTRY_WRITE_FIXTURES=1 vitest run src/doc/fixture.test.ts src/directory/fixture.test.ts",
    "wasm": "bash scripts/build-wasm.sh",
    "pwa-assets": "pwa-assets-generator"
  },
