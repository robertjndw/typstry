+//! Click-to-source and cursor-to-preview jumps against the last paged
+//! document, for editors that keep using the stock typst.ts JS wrapper.
+
+use std::{cell::RefCell, num::NonZeroUsize, rc::Rc, sync::Arc};
+
+use js_sys::{Array, Object, Reflect};
+use reflexo_typst::{BrowserCompilerFeat, TypstPagedDocument, WorldComputeGraph};
+use typst::diag::FileResult;
+use typst::foundations::{Bytes, Datetime, Duration};
+use typst::introspection::PagedPosition;
+use typst::layout::{Abs, Point};
+use typst::syntax::{FileId, RootedPath, Source, VirtualPath, VirtualRoot};
+use typst::text::{Font, FontBook};
+use typst::utils::LazyHash;
+use typst::{Library, World};
+use typst_ide::{IdeWorld, Jump};
+use wasm_bindgen::prelude::*;
+
+use crate::TypstCompiler;
+
+type Graph = Arc<WorldComputeGraph<BrowserCompilerFeat>>;
+
+/// The document is kept together with the world it was compiled in: spans
+/// only resolve against the sources that produced them, and a failed compile
+/// leaves the previous document on screen.
+pub(crate) type LastPaged = Rc<RefCell<Option<(Graph, Arc<TypstPagedDocument>)>>>;
+
+pub(crate) fn remember(last: &LastPaged, graph: &Graph, doc: &Arc<TypstPagedDocument>) {
+    *last.borrow_mut() = Some((graph.clone(), doc.clone()));
+}
+
+/// typst-ide wants an IdeWorld, which the orphan rule keeps us from
+/// implementing on reflexo's world directly.
+struct Ide<'a>(&'a dyn World);
+
+impl World for Ide<'_> {
+    fn library(&self) -> &LazyHash<Library> {
+        self.0.library()
+    }
+    fn book(&self) -> &LazyHash<FontBook> {
+        self.0.book()
+    }
+    fn main(&self) -> FileId {
+        self.0.main()
+    }
+    fn source(&self, id: FileId) -> FileResult<Source> {
+        self.0.source(id)
+    }
+    fn file(&self, id: FileId) -> FileResult<Bytes> {
+        self.0.file(id)
+    }
+    fn font(&self, index: usize) -> Option<Font> {
+        self.0.font(index)
+    }
+    fn today(&self, offset: Option<Duration>) -> Option<Datetime> {
+        self.0.today(offset)
+    }
+}
+
+impl IdeWorld for Ide<'_> {
+    fn upcast(&self) -> &dyn World {
+        self.0
+    }
+}
+
+fn object(entries: &[(&str, JsValue)]) -> JsValue {
+    let obj = Object::new();
+    for (key, value) in entries {
+        let _ = Reflect::set(&obj, &(*key).into(), value);
+    }
+    obj.into()
+}
+
+/// Pages are 0-based and coordinates are pt from the page's top-left, like
+/// the vector renderer's page layout.
+fn position(pos: &PagedPosition) -> JsValue {
+    object(&[
+        ("page", (pos.page.get() - 1).into()),
+        ("x", pos.point.x.to_pt().into()),
+        ("y", pos.point.y.to_pt().into()),
+    ])
+}
+
+#[wasm_bindgen]
+impl TypstCompiler {
+    /// Where a click on the last compiled document leads: `{path, package?,
+    /// offset}` (offset in UTF-16 units), `{url}`, `{page, x, y}`, or null.
+    pub fn jump_from_click(&self, page: usize, x: f64, y: f64) -> JsValue {
+        let last = self.last_paged.borrow();
+        let Some((graph, doc)) = last.as_ref() else {
+            return JsValue::NULL;
+        };
+        let world = Ide(&graph.snap.world);
+        let click = PagedPosition {
+            page: NonZeroUsize::MIN.saturating_add(page),
+            point: Point::new(Abs::pt(x), Abs::pt(y)),
+        };
+        match typst_ide::jump_from_click(&world, doc.as_ref(), &click) {
+            Some(Jump::File(id, offset)) => {
+                let Some(offset) = world
+                    .source(id)
+                    .ok()
+                    .and_then(|s| s.lines().byte_to_utf16(offset))
+                else {
+                    return JsValue::NULL;
+                };
+                // reflexo puts the workspace under a made-up package root
+                // (@ws/p0), so project files are told apart by sharing the
+                // main file's root, not by VirtualRoot::Project.
+                let package = match id.root() {
+                    root if root == world.main().root() => JsValue::UNDEFINED,
+                    VirtualRoot::Project => JsValue::UNDEFINED,
+                    VirtualRoot::Package(spec) => spec.to_string().into(),
+                };
+                object(&[
+                    ("path", id.vpath().get_with_slash().into()),
+                    ("package", package),
+                    ("offset", offset.into()),
+                ])
+            }
+            Some(Jump::Url(url)) => object(&[("url", url.as_str().into())]),
+            Some(Jump::Position(pos)) => position(&pos),
+            None => JsValue::NULL,
+        }
+    }
+
+    /// Where the text at a UTF-16 offset in a project file shows up in the
+    /// last compiled document. Usually one position, more for content that
+    /// repeats (headers, outlines), none for code that renders no text.
+    pub fn jump_from_cursor(&self, path: &str, offset: usize) -> Array {
+        let last = self.last_paged.borrow();
+        let Some((graph, doc)) = last.as_ref() else {
+            return Array::new();
+        };
+        let Ok(vpath) = VirtualPath::new(path) else {
+            return Array::new();
+        };
+        let world = &graph.snap.world;
+        let id = RootedPath::new(world.main().root().clone(), vpath).intern();
+        let Ok(source) = world.source(id) else {
+            return Array::new();
+        };
+        let Some(cursor) = source.lines().utf16_to_byte(offset) else {
+            return Array::new();
+        };
+        typst_ide::jump_from_cursor(doc.as_ref(), &source, cursor)
+            .iter()
+            .map(position)
+            .collect()
+    }
+}
