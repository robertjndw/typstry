{
  "name": "typstry",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,magenta \"pnpm --filter web dev\" \"cargo run -p typstry-server\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:e2e:static": "pnpm --filter web test:e2e:static",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1"
  }
}
